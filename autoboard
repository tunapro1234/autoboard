def build_parser() -> argparse.ArgumentParser:
    examples = list_example_names()
    parser = argparse.ArgumentParser(
        prog="autoboard",
        description="Schema/Layout stage-aware board checker and router for LLM agents.",
    )
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_status = sub.add_parser("status", help="Show persisted schema/layout state.")
    p_status.add_argument("--example", choices=examples, default="led")
    p_status.add_argument("--pretty", action="store_true", help="Human-readable status output")
    p_status.add_argument("--short", action="store_true", help="Single-line summary output")
    p_status.set_defaults(func=cmd_status)

    p_check = sub.add_parser("check", help="Run schema + layout placement checks.")
    p_check.add_argument("--example", choices=examples, default="led")
    p_check.add_argument("--clearance-mm", type=float, default=DEFAULT_CLEARANCE_MM)
    p_check.set_defaults(func=cmd_check)

    p_route = sub.add_parser("route", help="Run checks and then full layout route pipeline.")
    p_route.add_argument("--example", choices=examples, default="led")
    p_route.add_argument("--output", default=None, help="Output directory (default: output/<example>)")
    p_route.add_argument("--clearance-mm", type=float, default=DEFAULT_CLEARANCE_MM)
    p_route.add_argument("--force", action="store_true", help="Force rerun even with same failed board hash")
    p_route.set_defaults(func=cmd_route)

    p_forward = sub.add_parser("forward", help="Advance from checks to end (same as route flow).")
    p_forward.add_argument("--example", choices=examples, default="led")
    p_forward.add_argument("--output", default=None, help="Output directory (default: output/<example>)")
    p_forward.add_argument("--clearance-mm", type=float, default=DEFAULT_CLEARANCE_MM)
    p_forward.add_argument("--force", action="store_true", help="Force rerun even with same failed board hash")
    p_forward.set_defaults(func=cmd_forward)

    p_pull_forward = sub.add_parser("pull-forward", help="Alias of forward.")
    p_pull_forward.add_argument("--example", choices=examples, default="led")
    p_pull_forward.add_argument("--output", default=None, help="Output directory (default: output/<example>)")
    p_pull_forward.add_argument("--clearance-mm", type=float, default=DEFAULT_CLEARANCE_MM)
    p_pull_forward.add_argument("--force", action="store_true", help="Force rerun even with same failed board hash")
    p_pull_forward.set_defaults(func=cmd_forward)

    p_rewind = sub.add_parser("rewind", help="Reset state and run the full flow from scratch.")
    p_rewind.add_argument("--example", choices=examples, default="led")
    p_rewind.add_argument("--output", default=None, help="Output directory (default: output/<example>)")
    p_rewind.add_argument("--clearance-mm", type=float, default=DEFAULT_CLEARANCE_MM)
    p_rewind.add_argument("--force", action="store_true", help="Force rerun even with same failed board hash")
    p_rewind.set_defaults(func=cmd_rewind)

    p_reset = sub.add_parser("reset", help="Delete stored state for an example")
    p_reset.add_argument("--example", choices=examples, default="led")
    p_reset.set_defaults(func=cmd_reset)

    p_help = sub.add_parser("help", help="Show command help and quick recipes.")
    p_help.add_argument("topic", nargs="?", choices=[
        "status", "check", "route", "forward", "pull-forward", "rewind", "reset"
    ])
    p_help.set_defaults(func=cmd_help)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
