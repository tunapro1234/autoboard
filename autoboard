#!/usr/bin/env python3
"""Schema/Layout stage-aware CLI orchestrator for board checks and routing retries."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from datetime import datetime, timezone
from pathlib import Path

from boards import get_example, list_example_names
from src.circuit import Circuit
from src.export_pcb import COMP_SPACING, FOOTPRINTS, PIN_TO_PAD, full_pipeline

ROOT = Path(__file__).resolve().parent
STATE_DIR = ROOT / ".autoboard"
DEFAULT_CLEARANCE_MM = 0.2
GRID_START_X = 120.0
GRID_START_Y = 80.0
GRID_COLS = 4

SCHEMA_STAGES = ["schema_build", "schema_check"]
LAYOUT_STAGES = ["layout_place", "layout_export", "layout_route", "layout_check", "layout_pack"]
STAGE_ORDER = SCHEMA_STAGES + LAYOUT_STAGES


def _utc_now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def _state_path(example: str) -> Path:
    return STATE_DIR / f"{example}.json"


def _safe_rel(path: Path) -> str:
    try:
        return str(path.resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


def _empty_stage_entry() -> dict:
    return {"status": "pending", "details": [], "warnings": []}


def _new_stage_map() -> dict:
    return {name: _empty_stage_entry() for name in STAGE_ORDER}


def _default_state(example: str) -> dict:
    return {
        "example": example,
        "updated_at": _utc_now(),
        "last_status": "idle",
        "board_hash": None,
        "board_name": example,
        "attempt_count": 0,
        "last_failure": None,
        "last_success": None,
        "stages": _new_stage_map(),
        "artifacts": {},
    }


def _normalize_stage_entry(raw: dict | None) -> dict:
    entry = _empty_stage_entry()
    if not isinstance(raw, dict):
        return entry

    status = raw.get("status")
    if isinstance(status, str):
        entry["status"] = status

    details = raw.get("details")
    if isinstance(details, list):
        entry["details"] = [str(x) for x in details]
    elif details:
        entry["details"] = [str(details)]

    warnings = raw.get("warnings")
    if isinstance(warnings, list):
        entry["warnings"] = [str(x) for x in warnings]
    elif warnings:
        entry["warnings"] = [str(warnings)]

    if isinstance(raw.get("updated_at"), str):
        entry["updated_at"] = raw["updated_at"]

    return entry


def _normalize_state(example: str, raw: dict) -> dict:
    state = _default_state(example)
    if not isinstance(raw, dict):
        return state

    for key in ["updated_at", "last_status", "board_hash", "board_name", "attempt_count", "last_failure", "last_success"]:
        if key in raw:
            state[key] = raw[key]

    if isinstance(raw.get("artifacts"), dict):
        state["artifacts"] = raw["artifacts"]

    raw_stages = raw.get("stages") if isinstance(raw.get("stages"), dict) else {}
    has_new_keys = any(k in raw_stages for k in STAGE_ORDER)

    if has_new_keys:
        for stage in STAGE_ORDER:
            state["stages"][stage] = _normalize_stage_entry(raw_stages.get(stage))
    else:
        checks = _normalize_stage_entry(raw_stages.get("checks"))
        state["stages"]["schema_build"] = _empty_stage_entry()
        if state.get("board_hash"):
            state["stages"]["schema_build"]["status"] = "pass"
            state["stages"]["schema_build"]["details"] = ["board tanimi yuklendi"]

        state["stages"]["schema_check"] = _normalize_stage_entry(raw_stages.get("checks"))
        state["stages"]["layout_place"] = checks
        state["stages"]["layout_export"] = _normalize_stage_entry(raw_stages.get("export"))
        state["stages"]["layout_route"] = _normalize_stage_entry(raw_stages.get("route"))
        state["stages"]["layout_check"] = _normalize_stage_entry(raw_stages.get("drc"))
        state["stages"]["layout_pack"] = _normalize_stage_entry(raw_stages.get("pack"))

    return state


def _load_state(example: str) -> dict:
    path = _state_path(example)
    if not path.exists():
        return _default_state(example)

    with path.open() as f:
        raw = json.load(f)
    return _normalize_state(example, raw)


def _save_state(example: str, state: dict):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state["updated_at"] = _utc_now()
    path = _state_path(example)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w") as f:
        json.dump(state, f, indent=2, sort_keys=True)
    os.replace(tmp, path)


def _json_out(payload: dict, exit_code: int):
    print(json.dumps(payload, indent=2, sort_keys=True))
    return exit_code


def _rollup(statuses: list[str]) -> str:
    if any(s == "fail" for s in statuses):
        return "fail"
    if statuses and all(s == "pass" for s in statuses):
        return "pass"
    if any(s == "pass" for s in statuses):
        return "partial"
    return "pending"


def _loop_summary(state: dict) -> dict:
    stages = state.get("stages", {})
    schema_statuses = [stages.get(stage, {}).get("status", "pending") for stage in SCHEMA_STAGES]
    layout_statuses = [stages.get(stage, {}).get("status", "pending") for stage in LAYOUT_STAGES]
    return {
        "schema": {
            "status": _rollup(schema_statuses),
            "stages": {stage: stages.get(stage, _empty_stage_entry()) for stage in SCHEMA_STAGES},
        },
        "layout": {
            "status": _rollup(layout_statuses),
            "stages": {stage: stages.get(stage, _empty_stage_entry()) for stage in LAYOUT_STAGES},
        },
    }


def _status_short_line(example: str, state: dict, loops: dict) -> str:
    return (
        f"{example} "
        f"schema={loops['schema']['status']} "
        f"layout={loops['layout']['status']} "
        f"last={state.get('last_status', 'idle')} "
        f"hash={(state.get('board_hash') or '-')[:12]}"
    )


def _status_pretty_text(example: str, state: dict, loops: dict) -> str:
    lines = []
    lines.append(f"Example: {example}")
    lines.append(f"Last Status: {state.get('last_status', 'idle')}")
    lines.append(f"Board Hash: {state.get('board_hash') or '-'}")
    lines.append(f"Attempts: {state.get('attempt_count', 0)}")
    lines.append(f"Schema Loop: {loops['schema']['status']}")
    lines.append(f"Layout Loop: {loops['layout']['status']}")
    lines.append("")
    lines.append("Schema Stages:")
    for stage in SCHEMA_STAGES:
        ent = state["stages"].get(stage, {})
        detail = ent.get("details", [])
        detail_text = detail[0] if detail else "-"
        lines.append(f"  - {stage:13s} {ent.get('status', 'pending'):7s} {detail_text}")
    lines.append("")
    lines.append("Layout Stages:")
    for stage in LAYOUT_STAGES:
        ent = state["stages"].get(stage, {})
        detail = ent.get("details", [])
        detail_text = detail[0] if detail else "-"
        lines.append(f"  - {stage:13s} {ent.get('status', 'pending'):7s} {detail_text}")

    last_failure = state.get("last_failure")
    if last_failure:
        lines.append("")
        lines.append("Last Failure:")
        lines.append(f"  - stage: {last_failure.get('stage')}")
        lines.append(f"  - summary: {last_failure.get('summary')}")
    return "\n".join(lines)


def _footprint_kind(comp) -> str:
    if comp.footprint and comp.footprint in FOOTPRINTS:
        return comp.footprint
    return comp.kind


def _resolved_positions(circuit: Circuit, placement: dict[str, tuple[float, float]] | None) -> dict[str, tuple[float, float]]:
    positions: dict[str, tuple[float, float]] = {}
    idx = 0
    for ref, comp in circuit.components.items():
        if comp.simulation_only:
            continue

        if placement and ref in placement:
            positions[ref] = placement[ref]
        else:
            col = idx % GRID_COLS
            row = idx // GRID_COLS
            positions[ref] = (GRID_START_X + col * COMP_SPACING, GRID_START_Y + row * COMP_SPACING)
        idx += 1
    return positions


def _bbox(cx: float, cy: float, courtyard: dict) -> tuple[float, float, float, float]:
    x1 = cx + courtyard["x"]
    y1 = cy + courtyard["y"]
    x2 = x1 + courtyard["w"]
    y2 = y1 + courtyard["h"]
    return (min(x1, x2), min(y1, y2), max(x1, x2), max(y1, y2))


def _boxes_collide(a: tuple[float, float, float, float],
                   b: tuple[float, float, float, float],
                   clearance: float) -> bool:
    ax1, ay1, ax2, ay2 = a
    bx1, by1, bx2, by2 = b
    if ax2 + clearance <= bx1:
        return False
    if bx2 + clearance <= ax1:
        return False
    if ay2 + clearance <= by1:
        return False
    if by2 + clearance <= ay1:
        return False
    return True


def _component_net_view(circuit: Circuit) -> dict[str, list[tuple[str, str]]]:
    expected: dict[str, list[tuple[str, str]]] = {}
    for ref, comp in circuit.components.items():
        if comp.simulation_only:
            continue
        for pin, net in comp.pins.items():
            expected.setdefault(net, []).append((ref, pin))
    for net_name in expected:
        expected[net_name] = sorted(expected[net_name])
    return expected


def _net_registry_view(circuit: Circuit) -> dict[str, list[tuple[str, str]]]:
    actual: dict[str, list[tuple[str, str]]] = {}
    for net_name, net in circuit.nets.items():
        filtered = []
        for ref, pin in net.components:
            comp = circuit.components.get(ref)
            if comp is None or comp.simulation_only:
                continue
            filtered.append((ref, pin))
        if filtered:
            actual[net_name] = sorted(filtered)
    return actual


def _validate_nets(circuit: Circuit) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []

    for ref, comp in circuit.components.items():
        if comp.simulation_only:
            continue
        fp_kind = _footprint_kind(comp)
        if fp_kind not in FOOTPRINTS:
            errors.append(f"{ref}: footprint tanimsiz ({fp_kind})")
            continue

        pin_map = PIN_TO_PAD.get(comp.kind, PIN_TO_PAD.get(fp_kind, {}))
        if not pin_map:
            errors.append(f"{ref}: pin->pad map tanimsiz ({comp.kind}/{fp_kind})")
            continue

        for pin in comp.pins:
            if pin not in pin_map:
                errors.append(f"{ref}: pin mapte yok ({pin})")

    expected = _component_net_view(circuit)
    actual = _net_registry_view(circuit)

    if set(expected) != set(actual):
        missing = sorted(set(expected) - set(actual))
        extra = sorted(set(actual) - set(expected))
        if missing:
            errors.append(f"net registry eksik netler: {', '.join(missing)}")
        if extra:
            errors.append(f"net registry fazladan netler: {', '.join(extra)}")

    for net_name in sorted(set(expected) & set(actual)):
        if expected[net_name] != actual[net_name]:
            errors.append(f"net uyusmazligi: {net_name}")

    for net_name, conns in sorted(expected.items()):
        if len(conns) < 2:
            warnings.append(f"dangling net: {net_name} ({len(conns)} baglanti)")

    return errors, warnings


def _validate_placement(circuit: Circuit,
                        placement: dict[str, tuple[float, float]] | None,
                        board_size: tuple[float, float],
                        clearance: float) -> tuple[list[str], list[str]]:
    errors: list[str] = []
    warnings: list[str] = []

    board_w, board_h = board_size
    left = GRID_START_X - 10.0
    top = GRID_START_Y - 10.0
    right = GRID_START_X + board_w
    bottom = GRID_START_Y + board_h

    positions = _resolved_positions(circuit, placement)
    boxes: dict[str, tuple[float, float, float, float]] = {}

    for ref, comp in circuit.components.items():
        if comp.simulation_only:
            continue

        fp_kind = _footprint_kind(comp)
        fp_def = FOOTPRINTS.get(fp_kind)
        if fp_def is None:
            errors.append(f"{ref}: footprint bulunamadi ({fp_kind})")
            continue

        if ref not in positions:
            errors.append(f"{ref}: placement yok")
            continue

        cx, cy = positions[ref]
        box = _bbox(cx, cy, fp_def["courtyard"])
        boxes[ref] = box

        x1, y1, x2, y2 = box
        if x1 < left or y1 < top or x2 > right or y2 > bottom:
            errors.append(
                f"{ref}: board disina tasiyor "
                f"(bbox={x1:.2f},{y1:.2f},{x2:.2f},{y2:.2f} "
                f"board={left:.2f},{top:.2f},{right:.2f},{bottom:.2f})"
            )

    refs = sorted(boxes.keys())
    for i, ref_a in enumerate(refs):
        for ref_b in refs[i + 1:]:
            if _boxes_collide(boxes[ref_a], boxes[ref_b], clearance):
                errors.append(f"cakisma: {ref_a} <-> {ref_b}")

    if placement:
        missing_custom = sorted(
            ref for ref, comp in circuit.components.items()
            if not comp.simulation_only and ref not in placement
        )
        if missing_custom:
            warnings.append(
                "placement map eksik komponentler grid'e dustu: " + ", ".join(missing_custom)
            )

    return errors, warnings


def _build_fingerprint(circuit: Circuit,
                       board_size: tuple[float, float],
                       placement: dict[str, tuple[float, float]] | None) -> str:
    comps = []
    for ref in sorted(circuit.components.keys()):
        comp = circuit.components[ref]
        comps.append({
            "ref": ref,
            "kind": comp.kind,
            "value": comp.value,
            "unit": comp.unit,
            "footprint": comp.footprint,
            "simulation_only": comp.simulation_only,
            "pins": {k: comp.pins[k] for k in sorted(comp.pins.keys())},
        })

    payload = {
        "name": circuit.name,
        "board_size": [board_size[0], board_size[1]],
        "placement": {k: [v[0], v[1]] for k, v in sorted((placement or {}).items())},
        "components": comps,
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def _run_checks(example: str, clearance_mm: float) -> tuple[dict, dict, str, str]:
    spec = get_example(example)
    circuit = spec.builder()
    placement = spec.placement()
    board_hash = _build_fingerprint(circuit, spec.board_size, placement)

    net_errors, net_warnings = _validate_nets(circuit)
    placement_errors, placement_warnings = _validate_placement(circuit, placement, spec.board_size, clearance_mm)

    schema_ok = len(net_errors) == 0
    layout_place_ok = len(placement_errors) == 0

    check_result = {
        "ok": schema_ok and layout_place_ok,
        "schema": {
            "ok": schema_ok,
            "errors": net_errors,
            "warnings": net_warnings,
        },
        "layout_place": {
            "ok": layout_place_ok,
            "errors": placement_errors,
            "warnings": placement_warnings,
        },
        "errors": [*net_errors, *placement_errors],
        "warnings": [*net_warnings, *placement_warnings],
        "net_error_count": len(net_errors),
        "placement_error_count": len(placement_errors),
    }
    meta = {"circuit": circuit, "placement": placement, "board_size": spec.board_size}
    return check_result, meta, board_hash, str(spec.name)


def _set_stage(state: dict, stage: str, status: str,
               details: list[str] | None = None,
               warnings: list[str] | None = None):
    entry = state["stages"].setdefault(stage, _empty_stage_entry())
    entry["status"] = status
    entry["updated_at"] = _utc_now()
    if details is not None:
        entry["details"] = [str(x) for x in details]
    if warnings is not None:
        entry["warnings"] = [str(x) for x in warnings]


def _mark_downstream_pending(state: dict, start_stage: str):
    seen = False
    for stage in STAGE_ORDER:
        if stage == start_stage:
            seen = True
            continue
        if seen:
            _set_stage(state, stage, "pending", [], [])


def _apply_check_stages(state: dict, check_result: dict):
    _set_stage(state, "schema_build", "pass", ["board tanimi yuklendi"], [])
    _set_stage(
        state,
        "schema_check",
        "pass" if check_result["schema"]["ok"] else "fail",
        check_result["schema"]["errors"] or ["schema net kontrolu gecti"],
        check_result["schema"]["warnings"],
    )
    _set_stage(
        state,
        "layout_place",
        "pass" if check_result["layout_place"]["ok"] else "fail",
        check_result["layout_place"]["errors"] or ["placement kontrolu gecti"],
        check_result["layout_place"]["warnings"],
    )


def _check_failure_payload(board_hash: str, check_result: dict) -> dict:
    if not check_result["schema"]["ok"]:
        return {
            "hash": board_hash,
            "stage": "schema_check",
            "summary": "schema kontrolu basarisiz; netlist/pin baglantilarini duzelt",
            "details": check_result["schema"]["errors"],
            "warnings": check_result["schema"]["warnings"],
        }

    return {
        "hash": board_hash,
        "stage": "layout_place",
        "summary": "placement kontrolu basarisiz; cakisma/sinir ihlallerini duzelt",
        "details": check_result["layout_place"]["errors"],
        "warnings": check_result["layout_place"]["warnings"],
    }


def cmd_status(args) -> int:
    state = _load_state(args.example)
    loops = _loop_summary(state)

    if args.short:
        print(_status_short_line(args.example, state, loops))
        return 0

    if args.pretty:
        print(_status_pretty_text(args.example, state, loops))
        return 0

    payload = {
        "ok": True,
        "action": "status",
        "example": args.example,
        "loops": loops,
        "state": state,
    }
    return _json_out(payload, 0)


def cmd_check(args) -> int:
    state = _load_state(args.example)
    state["attempt_count"] = int(state.get("attempt_count", 0)) + 1

    check_result, _meta, board_hash, board_name = _run_checks(args.example, args.clearance_mm)
    state["board_hash"] = board_hash
    state["board_name"] = board_name
    _apply_check_stages(state, check_result)

    if check_result["ok"]:
        _mark_downstream_pending(state, "layout_place")
        state["last_status"] = "checks_passed"
        _save_state(args.example, state)
        payload = {
            "ok": True,
            "action": "check",
            "example": args.example,
            "board_hash": board_hash,
            "checks": check_result,
            "stages": state["stages"],
            "loops": _loop_summary(state),
        }
        return _json_out(payload, 0)

    failure = _check_failure_payload(board_hash, check_result)
    state["last_failure"] = failure
    state["last_status"] = "failed"
    if failure["stage"] == "schema_check":
        _mark_downstream_pending(state, "schema_check")
    else:
        _mark_downstream_pending(state, "layout_place")
    _save_state(args.example, state)

    payload = {
        "ok": False,
        "action": "check",
        "example": args.example,
        "board_hash": board_hash,
        "checks": check_result,
        "failure": failure,
        "stages": state["stages"],
        "loops": _loop_summary(state),
    }
    return _json_out(payload, 1)


def _pipeline_artifacts(output_dir: Path) -> dict:
    names = [
        "unrouted.kicad_pcb",
        "circuit.dsn",
        "circuit.ses",
        "routed.kicad_pcb",
        "drc_report.json",
        "routed.svg",
        "routed_3d_top.png",
        "routed_3d_bottom.png",
    ]
    out = {}
    for name in names:
        p = output_dir / name
        if p.exists() and p.is_file():
            out[name] = _safe_rel(p)

    gerber_dir = output_dir / "gerber"
    if gerber_dir.exists() and gerber_dir.is_dir():
        out["gerber_dir"] = _safe_rel(gerber_dir)
        out["gerber_count"] = len([x for x in gerber_dir.iterdir() if x.is_file()])

    return out


def _detail_from_step(step: dict, fallback: str) -> str:
    if not isinstance(step, dict):
        return fallback
    if step.get("error"):
        return str(step["error"])
    if step.get("stderr"):
        return str(step["stderr"]).strip() or fallback
    if step.get("stdout"):
        return str(step["stdout"]).strip() or fallback
    if step.get("output"):
        return str(step["output"]).strip() or fallback
    return fallback


def _run_route_action(args, action_name: str) -> int:
    state = _load_state(args.example)
    state["attempt_count"] = int(state.get("attempt_count", 0)) + 1

    check_result, meta, board_hash, board_name = _run_checks(args.example, args.clearance_mm)
    state["board_hash"] = board_hash
    state["board_name"] = board_name
    _apply_check_stages(state, check_result)

    last_failure = state.get("last_failure")
    if not args.force and last_failure and last_failure.get("hash") == board_hash:
        _save_state(args.example, state)
        payload = {
            "ok": False,
            "action": action_name,
            "example": args.example,
            "board_hash": board_hash,
            "reused_failure": True,
            "message": "Board degismemis. Ayni hatayi tekrarliyorum; route yeniden calistirilmadi.",
            "failure": last_failure,
            "stages": state.get("stages", {}),
            "loops": _loop_summary(state),
        }
        return _json_out(payload, 2)

    if not check_result["ok"]:
        failure = _check_failure_payload(board_hash, check_result)
        state["last_failure"] = failure
        state["last_status"] = "failed"
        if failure["stage"] == "schema_check":
            _mark_downstream_pending(state, "schema_check")
        else:
            _mark_downstream_pending(state, "layout_place")
        _save_state(args.example, state)

        payload = {
            "ok": False,
            "action": action_name,
            "example": args.example,
            "board_hash": board_hash,
            "failure": failure,
            "stages": state["stages"],
            "loops": _loop_summary(state),
        }
        return _json_out(payload, 1)

    _mark_downstream_pending(state, "layout_place")

    output_dir = Path(args.output) if args.output else ROOT / "output" / args.example
    output_dir.mkdir(parents=True, exist_ok=True)

    circuit: Circuit = meta["circuit"]
    placement = meta["placement"]
    board_w, board_h = meta["board_size"]
    result = full_pipeline(
        circuit,
        str(output_dir),
        board_width=board_w,
        board_height=board_h,
        placement=placement,
    )

    steps = result.get("steps", {})
    export_ok = bool(steps.get("export_unrouted", {}).get("ok")) and bool(steps.get("dsn_export", {}).get("ok"))
    route_ok = (
        bool(steps.get("freerouting", {}).get("ok"))
        and bool(steps.get("parse_ses", {}).get("ok"))
        and bool(steps.get("export_routed", {}).get("ok"))
    )
    drc_ok = bool(steps.get("drc", {}).get("ok"))

    render_step = steps.get("render", {})
    render_ok = isinstance(render_step, dict) and render_step and all(
        v.get("ok", False) for v in render_step.values() if isinstance(v, dict)
    )
    pack_ok = bool(steps.get("gerber", {}).get("ok")) and bool(render_ok)

    _set_stage(
        state,
        "layout_export",
        "pass" if export_ok else "fail",
        [
            _detail_from_step(steps.get("export_unrouted", {}), "unrouted export sonucu belirsiz"),
            _detail_from_step(steps.get("dsn_export", {}), "dsn export sonucu belirsiz"),
        ],
        [],
    )
    _set_stage(
        state,
        "layout_route",
        "pass" if route_ok else "fail",
        [
            _detail_from_step(steps.get("freerouting", {}), "freerouting sonucu belirsiz"),
            _detail_from_step(steps.get("parse_ses", {}), "ses parse sonucu belirsiz"),
        ],
        [],
    )
    _set_stage(
        state,
        "layout_check",
        "pass" if drc_ok else "fail",
        [_detail_from_step(steps.get("drc", {}), "drc sonucu belirsiz")],
        [],
    )
    _set_stage(
        state,
        "layout_pack",
        "pass" if pack_ok else "fail",
        [_detail_from_step(steps.get("gerber", {}), "gerber sonucu belirsiz")],
        [],
    )

    success = export_ok and route_ok and drc_ok
    state["artifacts"] = _pipeline_artifacts(output_dir)

    if success:
        state["last_status"] = "success"
        state["last_success"] = {"hash": board_hash, "timestamp": _utc_now()}
        state["last_failure"] = None
        _save_state(args.example, state)

        payload = {
            "ok": True,
            "action": action_name,
            "example": args.example,
            "board_hash": board_hash,
            "checks": check_result,
            "stages": state["stages"],
            "loops": _loop_summary(state),
            "artifacts": state["artifacts"],
        }
        return _json_out(payload, 0)

    if not route_ok:
        fail_stage = "layout_route"
        summary = "freerouting/layout route basarisiz; placement veya netleri duzelt"
        detail = _detail_from_step(steps.get("freerouting", {}), "freerouting cikti uretmedi")
    elif not drc_ok:
        fail_stage = "layout_check"
        summary = "routing tamamlandi ama layout check (DRC) basarisiz"
        detail = _detail_from_step(steps.get("drc", {}), "drc detay yok")
    else:
        fail_stage = "layout_export"
        summary = "layout export asamasi basarisiz"
        detail = _detail_from_step(steps.get("dsn_export", {}), "export detay yok")

    failure = {
        "hash": board_hash,
        "stage": fail_stage,
        "summary": summary,
        "details": [detail],
        "warnings": check_result["warnings"],
    }
    state["last_failure"] = failure
    state["last_status"] = "failed"
    _save_state(args.example, state)

    payload = {
        "ok": False,
        "action": action_name,
        "example": args.example,
        "board_hash": board_hash,
        "checks": check_result,
        "failure": failure,
        "stages": state["stages"],
        "loops": _loop_summary(state),
        "artifacts": state["artifacts"],
    }
    return _json_out(payload, 1)


def cmd_route(args) -> int:
    return _run_route_action(args, "route")


def cmd_forward(args) -> int:
    return _run_route_action(args, "forward")


def cmd_rewind(args) -> int:
    state_path = _state_path(args.example)
    if state_path.exists():
        state_path.unlink()

    result_code = _run_route_action(args, "rewind")
    return result_code if result_code != 0 else 0


def cmd_reset(args) -> int:
    path = _state_path(args.example)
    if path.exists():
        path.unlink()
    payload = {
        "ok": True,
        "action": "reset",
        "example": args.example,
        "state_path": _safe_rel(path),
    }
    return _json_out(payload, 0)


